{
  "name": "super-job-agent",
  "version": "0.1.5",
  "private": true,
  "description": "Super Job Agent v0.1.3 - Local-first AI job-application agent with LinkedIn Easy Apply autopilot (by Shashi Kumar Banoth).",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:ext": "npm run dev --workspace @superjob/extension",
    "dev:server": "npm run dev --workspace @superjob/server",
    "dev:dashboard": "npm run dev --workspace @superjob/dashboard",
    "build:dashboard": "npm run build --workspace @superjob/dashboard",
    "build:ext": "npm run build --workspace @superjob/extension",
    "build:release": "npm run build:ext && python3 ascii-fix.py && node scripts/verify-built-scripts.mjs",
    "ascii:fix": "python3 ascii-fix.py",
    "pack:ext": "npm run build:release && cd packages/extension/.output/chrome-mv3 && zip -r /home/user/SuperJobAgent_v0.1.2-autopilot-fix.zip .",
    "debug:ext": "tsx scripts/debug-extension.ts",
    "security:secrets": "node scripts/check-secrets.mjs",
    "test:demo": "tsx scripts/demo-functional-test.ts",
    "test:realtime": "tsx scripts/realtime-functional-test.ts",
    "dev:core": "npm run dev --workspace @superjob/core",
    "cli": "npm run cli --workspace @superjob/core",
    "profile:export": "npm run cli --workspace @superjob/core -- profile export",
    "profile:import": "npm run cli --workspace @superjob/core -- profile import",
    "profile:from-resume": "tsx packages/core/src/cli/index.ts profile from-resume",
    "apply": "npm run apply --workspace @superjob/applier",
    "discover": "npm run discover --workspace @superjob/applier",
    "login": "tsx packages/applier/src/cli/index.ts login",
    "crew": "npm run run --workspace @superjob/crew",
    "crew:schedule": "npm run schedule --workspace @superjob/crew",
    "serve": "tsx docker/api-server.ts",
    "docker:build": "docker compose -f docker/compose.yml build",
    "docker:up": "docker compose -f docker/compose.yml up -d",
    "docker:down": "docker compose -f docker/compose.yml down",
    "docker:logs": "docker compose -f docker/compose.yml logs -f",
    "docker:validate": "tsx docker/validate.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @superjob/core --if-present",
    "test:workspaces": "npm run test --workspaces --if-present",
    "test:integration": "npm run build --workspace @superjob/ats-config && node --test --import tsx integration/*.test.ts",
    "test:all": "npm run test:workspaces && npm run test:integration && npm run docker:validate",
    "postinstall": "npx playwright install chromium",
    "scrape": "npm run search --workspace @superjob/scraper",
    "email:scan": "npm run scan --workspace @superjob/email-monitor",
    "email:watch": "npm run watch --workspace @superjob/email-monitor",
    "build:ats-config": "npm run build --workspace @superjob/ats-config",
    "build:analytics": "npm run build --workspace @superjob/analytics",
    "verify:build": "node scripts/verify-built-scripts.mjs",
    "db:generate": "prisma generate --schema packages/server/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema packages/server/prisma/schema.prisma",
    "db:studio": "prisma studio --schema packages/server/prisma/schema.prisma"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}