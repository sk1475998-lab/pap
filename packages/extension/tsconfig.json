{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["chrome", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "~/*": ["./src/*"],
      "@superjob/ats-config": ["../ats-config/src/index.ts"],
      "@superjob/crew/fleet": ["../crew/src/fleet/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "wxt.config.ts",
    ".wxt/types/**/*.d.ts"
  ],
  "exclude": ["node_modules", "dist", ".output", "src/**/*-shashikumar.*"]
}
