{
  "name": "@superjob/crew",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./fleet": "./src/fleet/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "run": "tsx src/cli/index.ts run",
    "schedule": "tsx src/cli/index.ts schedule",
    "test": "node --test --import tsx src/**/*.test.ts"
  },
  "dependencies": {
    "@superjob/core": "*",
    "@superjob/scraper": "*"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
