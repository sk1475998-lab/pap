  "workflows": [
    {
      "name": "extension autofill",
      "entry_point": "packages/extension/src/lib/autofill.ts",
      "exit_conditions": [
        "fieldPolicyCheck",
        "fieldAlreadyFilledCheck",
        "fieldFillingSuccess",
        "fieldFillingRetry"
      ],
      "external_deps": [
        "chrome.runtime",
        "document/Element",
        "fetch",
        "CSS"
      ],
      "risk_surface": [
        "browser_event_driven_state",
        "react_spa_change_detection",
        "form_validation_complexity",
        "rate_limit_potential",
        "session_timeout",
        "coalesced_queue_processing"
      ]
    },
    {
      "name": "headless applier",
      "entry_point": "packages/applier/src/browser.ts",
      "exit_conditions": [
        "application_validation",
        "submission_attempt",
        "page_timeout",
        "browser_close"
      ],
      "external_deps": [
        "playwright",
        "https://www.linkedin.com",
        "generic ATS pages",
