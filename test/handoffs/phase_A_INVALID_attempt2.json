      "exit_conditions": [
        "delay_calculation",
        "pipeline_throttling",
        "inter_action_wait",
        "rate_limit_respect"
      ],
      "external_deps": [
        "exponential_backoff",
        "time_based_state",
        "external_api_affinity"
      ],
      "risk_surface": [
        "request_coalescing",
        "adaptive_pacing",
        "service_provider_flexibility",
        "cumulative_state_correlation",
        "external_api_fairness"
      ]
    }
  ],
  "brittle_selectors": [
    {
      "selector": "[data-automation-id]",
      "file": "packages/extension/src/lib/detector.ts",
      "reason": "Workday specific, may change with UI updates"
    },
    {
      "selector": "input[type=\"radio\"][name]",
      "file": "packages/extension/src/lib/autofill.ts",
      "reason": "Radio groups depend on consistent naming patterns"
    },
    {
      "selector": "input[type=\"file\"]",
      "file": "packages/extension/src/lib/filler.ts",
      "reason": "File input upload mechanism is platform-dependent"
    },
    {
      "selector": "[contenteditable=\"true\"]",
      "file": "packages/extension/src/lib/detector.ts",
      "reason": "Rich text editor detection is fragile with framework changes"
    },
    {
      "selector": "[class*=\"react-select\"][class*=\"__control\"]",
      "file": "packages/extension/src/lib/filler.ts",
      "reason": "React Select library implementation may vary"
    },
    {
      "selector": "wd-text-input, wd-select, wd-textarea",
      "file": "packages/extension/src/lib/detector.ts",
      "reason": "Workday web component name stability"
    },
    {
      "selector": ".jobs-easy-apply-modal",
      "file": "packages/extension/src/lib/content.ts",
      "reason": "LinkedIn Easy Apply modal structure changes over time"
    },
    {
      "selector": "[aria-label=\"*OTP*\", \"[placeholder*=\"*OTP*\"]",
      "file": "packages/extension/src/lib/login-agent.ts",
      "reason": "OTP field structure varies across authentication providers"
    },
    {
      "selector": ".form-group .input, .field .input",
      "file": "packages/extension/src/lib/detector.ts",
      "reason": "Generic CSS selector dependent on organizational styling"
    },
    {
      "selector": "input[aria-autocomplete=\"list\"]",
      "file": "packages/extension/src/lib/filler.ts",
      "reason": "Combobox attribute implementation varies across platforms"
    }
  ],
