        "otp_detection",
        "otp_field_identification",
        "otp_pause_trigger",
        "otp_resumption",
        "otp_validation_success"
      ],
      "external_deps": [
        "chrome.runtime.messaging",
        "document/Observable"
      ],
      "risk_surface": [
        "client_side_validation",
        "session_synchronization",
        "timing_attack_vector",
        "user_interaction_capture",
        "multi_tab_coordination"
      ]
    },
    {
      "name": "email monitor",
      "entry_point": "packages/email-monitor/src/monitor.ts",
      "exit_conditions": [
        "imap_connection",
        "incoming_message_processing",
        "attachment_extraction",
        "email_sanitization"
      ],
      "external_deps": [
        "IMAP protocol",
        "SMTP protocol",
        "TLS encryption",
        "email_parsing"
