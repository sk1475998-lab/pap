{
  "name": "sja-qa-runner",
  "version": "1.0.0",
  "description": "Orchestrator that directs an LLM to run the SJA QA pipeline with real tool execution",
  "main": "orchestrator.js",
  "scripts": {
    "start": "npx ts-node orchestrator.ts",
    "phase-a": "npx ts-node orchestrator.ts --only A",
    "phase-b": "npx ts-node orchestrator.ts --only B",
    "phase-c": "npx ts-node orchestrator.ts --only C",
    "phase-d": "npx ts-node orchestrator.ts --only D",
    "phase-e": "npx ts-node orchestrator.ts --only E",
    "resume": "npx ts-node orchestrator.ts --resume",
    "score": "npx ts-node score-calculator.ts",
    "verify": "npx ts-node audit-verifier.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@google/genai": "^2.10.0",
    "@google/generative-ai": "^0.24.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0"
  }
}
