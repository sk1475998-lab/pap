# Super Job Agent environment example
# Copy this file to .env locally. Never commit real secrets.

# LLM provider is optional. Core ATS, India Coach, and Job Recommendations work without it.
# Supported examples: none, ollama, openai, anthropic, gemini, openrouter
SUPERJOB_LLM_PROVIDER=none
SUPERJOB_LLM_MODEL=
SUPERJOB_LLM_BASE_URL=
SUPERJOB_LLM_API_KEY=

# Docker/API
PORT=3000
SUPERJOB_HOME=.super-job-agent

# Search defaults
SUPERJOB_KEYWORDS=frontend engineer
SUPERJOB_LOCATION=India
SUPERJOB_LIMIT=20
SUPERJOB_MIN_SCORE=60
SUPERJOB_DRY_RUN=true

# Optional email monitor settings. Use app passwords/OAuth where possible.
SUPERJOB_IMAP_HOST=
SUPERJOB_IMAP_PORT=993
SUPERJOB_IMAP_SECURE=true
SUPERJOB_IMAP_USER=
SUPERJOB_IMAP_PASS=
SUPERJOB_SMTP_HOST=
SUPERJOB_SMTP_PORT=587
SUPERJOB_SMTP_SECURE=false
SUPERJOB_SMTP_USER=
SUPERJOB_SMTP_PASS=

# ── Authentication (REQUIRED in production — Gap 7.1) ─────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRITICAL: Without this, each server instance generates its own random secret.
# All tokens break across instances when scaling to 2+ containers.
SUPERJOB_AUTH_SECRET=

# ── Supabase / PostgreSQL Database (Gap 2.2 — Multi-tenancy) ─────────────────
# Supabase Dashboard -> Project Settings -> Database:
# Connection Pooling (Session/Transaction mode on port 6543) for runtime queries:
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
#
# Direct connection (port 5432) for running migrations:
# DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
#
# Optional Supabase API Credentials (if using Supabase Auth or Storage):
# SUPABASE_URL=https://[project-ref].supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOi...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── Redis (Gap 2.1 — BullMQ job queue + WS ticket store) ──────────────────────
# Docker Compose: auto-set to redis://redis:6379 by compose.yml
# REDIS_URL=redis://localhost:6379

# ── Google OAuth ────────────────────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ── Stripe Billing ─────────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRO_MONTHLY_PRICE_ID=price_...
# STRIPE_PRO_ANNUAL_PRICE_ID=price_...
# STRIPE_ULTRA_MONTHLY_PRICE_ID=price_...

# ── CORS (production only) ─────────────────────────────────────────────────────
# SUPERJOB_ALLOWED_ORIGINS=https://app.superjobagent.com

# ── Dev / Local Session (loopback-only, never production) ─────────────────────
# SUPERJOB_ENABLE_DEV_SESSION=true

# ── Autopilot Concurrency (Gap 2.1) ────────────────────────────────────────────
# Max simultaneous Playwright sessions on this instance (each ~200-500MB RAM)
# SUPERJOB_MAX_CONCURRENT=3

# ── Residential Proxy (Gap 5.1 — cloud batch mode) ────────────────────────────
# Leave empty to use extension-first execution (no proxy cost, residential IP)
# SUPERJOB_PROXY_URL=http://user:pass@proxy.brightdata.com:22225

# ── App Public URL (Stripe checkout redirect) ──────────────────────────────────
# APP_PUBLIC_URL=https://your-domain.com
